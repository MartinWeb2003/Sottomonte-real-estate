# Sanity — create a project at sanity.io/manage and fill these in
NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Resend — email notifications for all four lead forms.
# Without RESEND_API_KEY the forms log to the server console in development and
# hard-fail in production, rather than telling the visitor a lead was sent when
# it was not.
RESEND_API_KEY=
# Where leads are delivered.
AGENCY_EMAIL=info@sottomonte.hr
# Sender. MUST be on a domain verified in Resend or every send is rejected.
RESEND_FROM=Sottomonte Web <web@sottomonte.hr>

# MapTiler — custom navy map style
NEXT_PUBLIC_MAPTILER_KEY=

# GA4 (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Canonical site URL (for sitemap / OG / JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
